{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./*"
      ],
      "components": [
        "./app/components"
      ],
      "assets/*": [
        "./app/assets/*"
      ],
      "theme/*": [
        "./theme/*"
      ],
      "services/*": [
        "./app/services/*"
      ],
      "store/*": [
        "./app/store/*"
      ],
      "types/*": [
        "./app/types/*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts",
    "nativewind-env.d.ts"
  ],
  "exclude": [
    "node_modules",
    "babel.config.js",
    "metro.config.js"
  ]
}